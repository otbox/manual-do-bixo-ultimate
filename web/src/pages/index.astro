---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadAllEdicoes } from '../utils/load-capitulos';
import { getCapaTema } from '../data/capas';
import { totalPaginasConteudo } from '../utils/volume-continuo';

const edicoes = loadAllEdicoes();
const totalQuadros = totalPaginasConteudo(edicoes);
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section class="home-hero">
    <h1>Manual do Bixo Ultimate</h1>
    <p>
      Guia satírico pra calouro da Unicamp — agora em formato de gibi folheável.
      Escolha uma edição ou leia o volume inteiro sem parar.
    </p>
  </section>

  <a class="volume-cta" href={`${base}completo/`}>
    <span class="volume-cta__badge">MODO EXTRA</span>
    <h2 class="volume-cta__titulo">Ler o manual completo</h2>
    <p class="volume-cta__texto">
      {edicoes.length} edições · {totalQuadros} quadros · um flipbook contínuo,
      capítulo atrás de capítulo.
    </p>
    <span class="volume-cta__action">Abrir volume →</span>
  </a>

  <h2 class="home-edicoes-titulo">Ou escolha uma edição</h2>

  <ul class="edicoes-lista">
    {
      edicoes.map((edicao) => {
        const capa = getCapaTema(edicao.numero);
        return (
          <li>
            <a
              class:list={['edicao-card', `edicao-card--${capa.tema}`]}
              href={`${base}edicao/${edicao.slug}/`}
            >
              <span class="edicao-card__num">ISSUE #{String(edicao.numero).padStart(2, '0')}</span>
              <span class="edicao-card__estampa">{capa.estampa}</span>
              <h2 class="edicao-card__titulo">{edicao.titulo}</h2>
              <p class="edicao-card__tagline">{capa.tagline}</p>
              <p>{edicao.paginas.length} páginas · {capa.subtitulo}</p>
            </a>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
