---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadAllEdicoes } from '../utils/load-capitulos';

const edicoes = loadAllEdicoes();
---

<BaseLayout>
  <section class="home-hero">
    <h1>Manual do Bixo Ultimate</h1>
    <p>
      Guia satírico pra calouro da Unicamp — agora em formato de gibi folheável.
      Escolha uma edição e vire a página.
    </p>
  </section>

  <ul class="edicoes-lista">
    {
      edicoes.map((edicao) => (
        <li>
          <a class="edicao-card" href={`${import.meta.env.BASE_URL}edicao/${edicao.slug}/`}>
            <span class="edicao-card__num">Edição Nº {String(edicao.numero).padStart(2, '0')}</span>
            <h2 class="edicao-card__titulo">{edicao.titulo}</h2>
            <p>{edicao.paginas.length} páginas · virar ou rolar</p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
