---
import { getCapaTema } from '../data/capas';
import CapaIcone from './CapaIcone.astro';

interface Props {
  titulo: string;
  numero: number;
  totalPaginas: number;
  slug?: string;
}
const { titulo, numero, totalPaginas } = Astro.props;
const edicaoLabel = String(numero).padStart(2, '0');
const capa = getCapaTema(numero);
---

<article
  class:list={['capa', `capa--${capa.tema}`, `capa-motivo--${capa.motivo}`]}
  aria-label={`Capa da edição ${edicaoLabel}: ${titulo}`}
>
  <div class="capa__halftone" aria-hidden="true"></div>
  <div class="capa__motif" aria-hidden="true"></div>
  <div class="capa__slash" aria-hidden="true"></div>
  <span class="capa__watermark" aria-hidden="true">#{edicaoLabel}</span>

  <div class="capa__top">
    <div class="capa__masthead">
      <span class="capa__selo">MANUAL DO BIXO</span>
      <span class="capa__serie">ULTIMATE · FT 2026</span>
    </div>
    <span class="capa__issue">Nº {edicaoLabel}</span>
  </div>

  <div class="capa__hero">
    <div class="capa__icone-wrap" aria-hidden="true">
      <CapaIcone icone={capa.icone} />
    </div>
    <p class="capa__tagline">{capa.tagline}</p>
    <h1 class="capa__titulo">{titulo}</h1>
    <p class="capa__subtitulo">{capa.subtitulo}</p>
    <span class="capa__estampa">{capa.estampa}</span>
  </div>

  <footer class="capa__rodape">
    <span class="capa__preco">R$ 3,00</span>
    <span class="capa__badge">{totalPaginas} QUADROS</span>
    <span class="capa__cta">VIRE →</span>
  </footer>
</article>
