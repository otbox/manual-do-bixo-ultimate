---
interface Props {
  titulo: string;
  numero: number;
  totalPaginas: number;
}
const { titulo, numero, totalPaginas } = Astro.props;
const edicaoLabel = String(numero).padStart(2, '0');
---

<article class="capa" aria-label={`Capa da edição ${edicaoLabel}: ${titulo}`}>
  <div class="capa__halftone" aria-hidden="true"></div>
  <div class="capa__slash" aria-hidden="true"></div>

  <div class="capa__top">
    <span class="capa__selo">MANUAL DO BIXO</span>
    <span class="capa__issue">ISSUE #{edicaoLabel}</span>
  </div>

  <div class="capa__hero">
    <p class="capa__tagline">ORIGEM · CALOURO · UNICAMP</p>
    <h1 class="capa__titulo">{titulo}</h1>
    <p class="capa__subtitulo">A HQ satírica que o DAC não imprimiu</p>
  </div>

  <footer class="capa__rodape">
    <span class="capa__badge">{totalPaginas} QUADROS</span>
    <span class="capa__cta">VIRE →</span>
  </footer>
</article>
