---
interface Props {
  src: string;
  alt: string;
}

/** Resolve caminho do markdown → URL pública do site. */
function resolveSrc(src: string, base: string): string {
  if (/^https?:\/\//i.test(src)) return src;
  const cleaned = src
    .replace(/^\.\.\/assets\//, 'assets/')
    .replace(/^\.\.\/\.\.\/assets\//, 'assets/')
    .replace(/^\//, '');
  const baseNorm = base.endsWith('/') ? base : `${base}/`;
  return `${baseNorm}${cleaned}`;
}

const { src, alt } = Astro.props;
const href = resolveSrc(src, import.meta.env.BASE_URL);
const isTirinha = /tirinha|meme/i.test(src) || /tirinha|meme/i.test(alt);
---

<figure class:list={['figura-hq', { 'figura-hq--tirinha': isTirinha }]}>
  <img class="figura-hq__img" src={href} alt={alt} loading="lazy" decoding="async" />
  {alt && <figcaption class="figura-hq__legenda">{alt}</figcaption>}
</figure>
